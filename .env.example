# Copy to .env and fill in. .env is gitignored. Never commit real values.
# Any connector whose credentials are missing is reported as "Not connected"
# on the Inbox/Settings pages; the rest of the system keeps working.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
SALESOS_TIMEZONE=Europe/London
SALESOS_DB_PATH=data/salesos.db
SALESOS_DATA_DIR=data
SALESOS_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# HubSpot (Tier 1) — Private App access token
# Scopes: crm.objects.deals.read, crm.objects.companies.read,
#         crm.objects.contacts.read, crm.objects.owners.read,
#         crm.schemas.deals.read, sales-email-read (optional, for logged emails)
# Write scope (crm.objects.deals.write / tasks) only if approval-gated writes are enabled.
# ---------------------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_IDS=            # optional, comma-separated; blank = all pipelines

# ---------------------------------------------------------------------------
# Google Sheets (Tier 1) — service account JSON path OR OAuth client
# The sheet must be shared with the service account email.
# Fallback if blocked: export the "Today" tab as CSV into data/inbox/prospecting/
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Today

# ---------------------------------------------------------------------------
# Calendly (Tier 1) — Personal Access Token (v2 API)
# ---------------------------------------------------------------------------
CALENDLY_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Excel (Tier 1, file-based) — path to a locally synced workbook.
# Leave blank to use the drop folder data/inbox/excel/ (latest file wins).
# Column mapping lives in config/excel_mapping.yaml
# ---------------------------------------------------------------------------
EXCEL_SYNCED_FILE_PATH=

# ---------------------------------------------------------------------------
# Microsoft To-Do (Tier 2, optional) — Microsoft Graph delegated auth.
# Expected to fail under corporate tenant restrictions. Leave blank to disable.
# ---------------------------------------------------------------------------
MS_GRAPH_CLIENT_ID=
MS_GRAPH_TENANT_ID=

# ---------------------------------------------------------------------------
# AI provider — optional. The system runs fully without AI (deterministic mode).
# AI_PROVIDER: none | openai | local | <other approved provider>
# ---------------------------------------------------------------------------
AI_PROVIDER=none
AI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=                 # also used for OpenAI-compatible local servers (e.g. http://localhost:11434/v1)
AI_MAX_INPUT_CHARS=40000
AI_REDACT_EMAIL_ADDRESSES=false  # replace email addresses with placeholders before sending to the provider
