{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "salesos/action_candidate/v1",
  "title": "Things the user needs to do next, extracted from one evidence item",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "quote", "extraction_confidence"],
        "properties": {
          "title": { "type": "string", "maxLength": 100, "description": "Imperative, e.g. 'Send revised pricing'" },
          "description": { "type": ["string", "null"], "maxLength": 300 },
          "due_text": { "type": ["string", "null"], "maxLength": 60 },
          "quote": { "type": "string", "minLength": 8, "maxLength": 400 },
          "linked_memory_subject": { "type": ["string", "null"], "maxLength": 80, "description": "Subject of the COMMITMENT/NEXT_STEP this action fulfils, if any" },
          "extraction_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
