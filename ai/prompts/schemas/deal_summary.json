{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "salesos/deal_summary/v1",
  "title": "Closed-world deal summary: every sentence must cite supplied ids",
  "type": "object",
  "additionalProperties": false,
  "required": ["sentences"],
  "properties": {
    "sentences": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "cites"],
        "properties": {
          "text": { "type": "string", "maxLength": 200, "description": "Plain statement. No numbers for deal value or dates; the UI renders those from structured data." },
          "cites": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "description": "memory id or evidence id from the input" }
          }
        }
      }
    }
  }
}
